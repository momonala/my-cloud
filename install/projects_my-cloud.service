[Unit]
Description=my-cloud web app: Find My and Photos
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/mnalavadi/my-cloud
Type=idle
ExecStart=/home/mnalavadi/.local/bin/uv run mycloud serve
User=mnalavadi
# tmpfs for session files that libraries rewrite constantly; see src/core/ram_files.py.
RuntimeDirectory=my-cloud
RuntimeDirectoryMode=0700

# The poller handles its own exceptions, so an exit means something it could
# not recover from.
Restart=always
RestartSec=10

# Backstop against the Anisette VM recycling in src/findmy/airtags.py failing, whose
# failure mode is accumulating VMs rather than a crash. Steady state is ~165 MB;
# hitting this means that recycling needs looking at. See "Why RAM saw-tooths"
# in README.md.
MemoryMax=512M

[Install]
WantedBy=multi-user.target
